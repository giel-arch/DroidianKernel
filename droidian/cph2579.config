########################################################################
# Oppo A38 (CPH2579, cph2579) device-specific fragment.
#
# The base defconfig (droidian_cph2579_defconfig) is the complete stock
# configuration extracted from the shipped boot_a kernel image, so all
# MTK device options (LCM panel list, imgsensor 'atom' family, touch,
# sensors, LEDs, ION, Mali Valhall GPU) are already set correctly.
# Nothing needs overriding here yet; keep this file as the hook for
# device-specific fixes discovered during bring-up.
########################################################################

# The oplus6769_* dtbo overlays #include per-project cust.dtsi files that
# Oppo does not publish in the public tree. The STOCK dtbo partition is kept
# on the device anyway (this port never flashes dtbo), so skip building the
# overlays entirely - dtbs then only produces the base mt6768.dtb that goes
# into boot.img.
# CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE is not set

# Bring-up aid: console on the MTK fbdev (mtkfb) so early panics are VISIBLE
# on screen (tux/SMP line + panic text). Disable again once graphical boot is
# proven - halium prefers CONFIG_FRAMEBUFFER_CONSOLE off.
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y

# Bring-up DEBUG: disable the MTK scheduler-perf vendor stack. Freshly
# forked tasks (initramfs daemons' children) wedge on this platform outside
# Android userspace; these hooks touch fork/exec/sched paths. Re-enable one
# by one once graphical boot is proven.
# CONFIG_MTK_TASK_TURBO is not set
# CONFIG_MTK_FPSGO_V3 is not set
# CONFIG_MTK_PERF_OBSERVER is not set
# CONFIG_MTK_PERFORMANCE_MODULE is not set
# NOTE: CONFIG_MTK_SCHED_EXTENSION and CONFIG_CPU_ISOLATION must stay =y -
# MTK's fair.c includes kernel/sched/extension/eas_plus.h (struct
# perf_order_domain) without a working guard when they are off.

# oplus_phoenix watchdog: reboots the device after phx kernel_time=240s
# without ColorOS userspace heartbeat (LK cmdline: phx_rus_conf.kernel_time=240)
# - kills any initramfs/recovery/Droidian session. Disabled for bring-up.
# CONFIG_OPLUS_FEATURE_PHOENIX is not set

# headless boot appearance: no tux logo painted by mtkfb
# CONFIG_LOGO is not set
