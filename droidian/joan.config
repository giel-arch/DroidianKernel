########################################################################
# Oppo A38 (CPH2579, joan) device-specific fragment.
#
# The base defconfig (droidian_joan_defconfig) is the complete stock
# configuration extracted from the shipped boot_a kernel image, so all
# MTK device options (LCM panel list, imgsensor 'atom' family, touch,
# sensors, LEDs, ION, Mali Valhall GPU) are already set correctly.
# Nothing needs overriding here yet; keep this file as the hook for
# device-specific fixes discovered during bring-up.
########################################################################

# The oplus6769_* dtbo overlays #include per-project cust.dtsi files that
# Oppo does not publish in the public tree. The STOCK dtbo partition is kept
# on the device anyway (this port never flashes dtbo), so skip building the
# overlays entirely - dtbs then only produces the base mt6768.dtb that goes
# into boot.img.
# CONFIG_BUILD_ARM64_DTB_OVERLAY_IMAGE is not set
