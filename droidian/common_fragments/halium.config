########################################################################
# Halium common kernel config fragment - Oppo A38 (joan), kernel 4.19
#
# Derived by running Halium's halium-boot check-kernel-config against the
# stock config extracted from boot_a.img (extract-ikconfig). Symbols that
# no longer exist in 4.19 are intentionally omitted; unknown symbols are
# ignored by merge_config.
#
# NOTE: the stock MTK config ships with CONFIG_DEVTMPFS disabled (Android
# init uses coldboot) - it MUST be on for the Halium/Droidian initramfs.
########################################################################

# devtmpfs (required by the halium initramfs)
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# virtual terminals
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y

# namespaces + cgroups (LXC android container)
CONFIG_NAMESPACES=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_NET_NS=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y

# systemd requirements
CONFIG_POSIX_MQUEUE=y
CONFIG_AUTOFS4_FS=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_FANOTIFY=y
CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y

# AppArmor as default LSM; SELinux compiled but disabled at boot via
# androidboot.selinux=permissive (kernel cmdline)
CONFIG_SECURITY=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_BOOTPARAM_VALUE=0
CONFIG_SECURITY_SELINUX_DEVELOP=y

# keep Android-isms that break GNU/Linux away
# CONFIG_ANDROID_LOW_MEMORY_KILLER is not set
# CONFIG_ANDROID_PARANOID_NETWORK is not set
# CONFIG_FW_LOADER_USER_HELPER is not set
# CONFIG_FW_LOADER_USER_HELPER_FALLBACK is not set
# CONFIG_DEVKMEM is not set

# bluetooth profiles over bluebinder/vhci (kernel-side BlueZ stack)
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y

# USB gadget functions (adb/functionfs, rndis network, mass storage)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_UEVENT=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_F_RNDIS=y
CONFIG_USB_CONFIGFS_F_MASS_STORAGE=y

# binder / ashmem (explicit; stock config already enables them via
# CONFIG_ANDROID_DEFAULT_SETTING selects)
CONFIG_ANDROID=y
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ASHMEM=y

# dm + loop for the Droidian initramfs (super dynamic partitions, LVM rootfs)
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y

# runtime config inspection
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
