########################################################################
# Droidian common kernel config fragment (applies to every port)
########################################################################

# initramfs and early-boot requirements
CONFIG_RD_GZIP=y
CONFIG_RD_LZ4=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_SYSVIPC=y
CONFIG_SWAP=y
