#!/bin/sh
# ALWAYS-ON bring-up diagnostics: RNDIS + telnetd + dropbear ~15s into the
# initramfs, kernel log forced visible on the framebuffer console.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
prereqs) prereqs; exit 0 ;;
esac

LOCAL_IP=192.168.2.15
ANDROID_USB=/sys/class/android_usb/android0
GADGET_DIR=/config/usb_gadget

write() { echo -n "$2" >"$1" 2>/dev/null; }

(
    # restore full kernel printk to the console (LK may append quiet/loglevel)
    echo 7 > /proc/sys/kernel/printk 2>/dev/null
    dmesg -n 7 2>/dev/null
    echo "==== cph2579 initrd debug overlay alive ====" > /dev/console 2>&1

    mkdir -p /dev/pts /run
    grep -q devpts /proc/mounts 2>/dev/null || \
        mount -t devpts -o noexec,nosuid,gid=5,mode=0620 devpts /dev/pts 2>/dev/null
    ls -l /dev/ptmx > /dev/console 2>&1
    ls /dev/pts > /dev/console 2>&1

    mkdir -p /config
    mount -t configfs none /config 2>/dev/null

    if [ -d $ANDROID_USB ]; then
        write $ANDROID_USB/enable 0
        write $ANDROID_USB/functions ""
        write $ANDROID_USB/idVendor 18D1
        write $ANDROID_USB/idProduct D001
        write $ANDROID_USB/iManufacturer "Halium initrd"
        write $ANDROID_USB/iProduct "initrd ssh 192.168.2.15"
        write $ANDROID_USB/iSerial "cph2579 bring-up"
        write $ANDROID_USB/functions rndis
        write $ANDROID_USB/enable 1
    elif [ -d $GADGET_DIR ]; then
        mkdir $GADGET_DIR/g1 2>/dev/null
        write $GADGET_DIR/g1/idVendor "0x18D1"
        write $GADGET_DIR/g1/idProduct "0xD001"
        mkdir -p $GADGET_DIR/g1/strings/0x409
        write $GADGET_DIR/g1/strings/0x409/serialnumber "cph2579 bring-up"
        write $GADGET_DIR/g1/strings/0x409/manufacturer "Halium initrd"
        write $GADGET_DIR/g1/strings/0x409/product "initrd ssh 192.168.2.15"
        mkdir -p $GADGET_DIR/g1/functions/rndis.usb0 2>/dev/null
        mkdir -p $GADGET_DIR/g1/configs/c.1/strings/0x409 2>/dev/null
        write $GADGET_DIR/g1/configs/c.1/strings/0x409/configuration "rndis"
        ln -sf $GADGET_DIR/g1/functions/rndis.usb0 $GADGET_DIR/g1/configs/c.1
        UDC=$(ls /sys/class/udc 2>/dev/null | grep -v dummy | head -1)
        write $GADGET_DIR/g1/UDC "$UDC"
    fi

    # The halium break handler may already have configured 192.168.2.15 on
    # an interface - detect that instead of bailing out.
    IFACE=$(ifconfig -a 2>/dev/null | awk '/^[a-zA-Z0-9_]+:/{i=$1} /192\.168\.2\.15/{print i; exit}' | tr -d ':')
    if [ -z "$IFACE" ]; then
        /sbin/ifconfig rndis0 $LOCAL_IP 2>/dev/null && IFACE=rndis0
        [ -z "$IFACE" ] && /sbin/ifconfig usb0 $LOCAL_IP 2>/dev/null && IFACE=usb0
    fi

    if [ -z "$IFACE" ]; then
        echo "init-top/00-telnetd: USB setup FAILED" > /dev/console 2>&1
        exit 0
    fi
    echo "init-top/00-telnetd: shell services on $IFACE $LOCAL_IP (telnet:23/25 ssh:22)" > /dev/console 2>&1

    # DHCP server so the PC automatically gets an address on the RNDIS link
    echo "start 192.168.2.20" >/etc/udhcpd.conf
    echo "end 192.168.2.90" >>/etc/udhcpd.conf
    echo "lease_file /var/udhcpd.leases" >>/etc/udhcpd.conf
    echo "interface $IFACE" >>/etc/udhcpd.conf
    echo "option subnet 255.255.255.0" >>/etc/udhcpd.conf
    busybox udhcpd 2>/dev/null

    busybox telnetd -b 0.0.0.0:23 -l /bin/sh 2>/dev/null
    busybox telnetd -b 0.0.0.0:25 -l /bin/sh 2>/dev/null

    ############################################################
    # UDP push channel + fork/exec liveness probes
    # PC:  socat -u UDP-RECV:9999 - | tee v7-dump.txt
    #  or: nc -lu 9999 > v7-dump.txt
    ############################################################
    DST=192.168.2.1
    push() { { echo "==== $1 ===="; shift; "$@"; } 2>&1 | busybox nc -u -w1 $DST 9999; }

    (
        sleep 2
        push "PROBE0-parent-alive" sh -c 'echo parent-shell-exec-ok'
        sleep 3
        push "PROBE1-fork-child" sh -c 'echo fork-child-exec-ok'
        ( echo "PROBE2-background-subshell-ok" | busybox nc -u -w1 $DST 9999 ) &
        sleep 2
        busybox setsid sh -c 'echo PROBE3-setsid-exec-ok | busybox nc -u -w1 192.168.2.1 9999' 2>/dev/null
        sleep 2
        push "PROBE4-state" sh -c 'cat /proc/cmdline; echo; cat /proc/loadavg; echo; cat /sys/devices/system/cpu/online; echo OFFLINE=$(cat /sys/devices/system/cpu/offline 2>/dev/null); echo; cat /proc/sys/kernel/printk; echo; ps -w 2>/dev/null | head -25; echo; ls -l /dev/ptmx /dev/console 2>&1; echo; ls /dev/pts 2>&1; echo; cat /proc/mounts | head -15; echo; ls /dev/disk/by-partlabel/ 2>&1'
        sleep 2
        push "DMESG-TAIL" sh -c 'dmesg | tail -80'
    ) &

    (
        while :; do
            dmesg | tail -25 | busybox nc -u -w1 $DST 9999 2>/dev/null
            sleep 10
        done
    ) &

    # unlock root: passwd gets a KNOWN hash (password: droidian)
    sed -i 's|^root:[^:]*:|root:$1$cph2579$wJqIiEMrBy6CfP1kXY62P.:|' /etc/passwd 2>/dev/null
    [ -f /etc/shadow ] && sed -i 's|^root:[^:]*:|root:$1$cph2579$wJqIiEMrBy6CfP1kXY62P.:|' /etc/shadow 2>/dev/null
    mkdir -p /etc/dropbear
    dropbear -R -B -E -p 22 2>/dev/null || dropbear -R -B -E 2>/dev/null

    # Post-mortem via mtkclient: keep writing kmsg + state snapshot to the
    # expdb partition (MTK exception/debug, 40 MiB -> 81920 x 512B sectors).
    # Read it back from BROM mode:  python3 -m mtk r expdb expdb.bin
    # (MTK aee-ipanic additionally records real kernel panics there itself.)
    (
        sleep 3
        EXPDB=""
        for p in /sys/class/block/mmcblk0p*; do
            [ "$(cat $p/size 2>/dev/null)" = "81920" ] && EXPDB=/dev/$(basename $p) && break
        done
        if [ -n "$EXPDB" ]; then
            echo "init-top: post-mortem log -> $EXPDB (expdb)" > /dev/console 2>&1
            # FIRST snapshot immediately (before anything can wedge)
            {
                echo "==== snapshot $(cat /proc/uptime) ===="
                echo "== cmdline =="; cat /proc/cmdline 2>/dev/null
                echo "== PSTORE (previous boot panic log!) =="
                for f in /sys/fs/pstore/*; do
                    [ -e "$f" ] || continue
                    echo "---- $f ----"; cat "$f" 2>/dev/null | tail -c 200000
                done
                echo "== mounts =="; cat /proc/mounts 2>/dev/null
                echo "== ps =="; ps -w 2>/dev/null
                echo "== kmsg tail =="; dmesg 2>/dev/null | tail -c 300000
            } > $EXPDB 2>/dev/null
            # after ~240s of the (headless) boot, do a WARM reboot so the
            # next boot's pstore snapshot captures this boot's full console
            # (DRAM survives kernel_restart; power-hold does NOT).
            N=0
            while :; do
                N=$((N+1))
                if [ $N -ge 45 ]; then
                    {
                        echo "==== FINAL snapshot (auto warm-reboot now) ===="
                        echo "== kmsg tail =="; dmesg 2>/dev/null | tail -c 300000
                        echo "== ps =="; ps -w 2>/dev/null
                    } > $EXPDB 2>/dev/null
                    sync
                    echo b > /proc/sysrq-trigger 2>/dev/null || reboot -f
                fi
                {
                    echo "==== snapshot $(cat /proc/uptime) ===="
                    echo "== PSTORE (previous boot panic log!) =="
                    for f in /sys/fs/pstore/*; do
                        [ -e "$f" ] || continue
                        echo "---- $f ----"; cat "$f" 2>/dev/null | tail -c 200000
                    done
                    echo "== mounts =="; cat /proc/mounts 2>/dev/null
                    echo "== ps =="; ps -w 2>/dev/null
                    echo "== kmsg tail =="; dmesg 2>/dev/null | tail -c 300000
                } > $EXPDB 2>/dev/null
                sleep 5
            done
        else
            echo "init-top: expdb partition not found" > /dev/console 2>&1
        fi
    ) &

    # HTTP diagnostics - works even if interactive sessions are broken
    mkdir -p /www
    (
        while :; do
            {
                echo "<html><body><pre>"
                echo "== cmdline =="; cat /proc/cmdline
                echo "== dmesg tail 100 =="; dmesg | tail -100 | sed 's/</\</g'
                echo "== partlabel =="; ls /dev/disk/by-partlabel/ 2>/dev/null
                echo "== mounts =="; cat /proc/mounts
                echo "== lvm =="; lvs 2>&1; vgs 2>&1; pvs 2>&1
                echo "== pstore =="; ls /sys/fs/pstore/ 2>/dev/null
                echo "== ps =="; ps -ef 2>/dev/null || ps
                echo "</pre></body></html>"
            } > /www/index.html 2>&1
            sleep 10
        done
    ) &
    busybox httpd -p 80 -h /www 2>/dev/null

    # continuously mirror the kernel log to the framebuffer console
    while :; do
        dmesg | tail -35 > /dev/console 2>&1
        sleep 15
    done
) &
