#!/bin/sh
# ALWAYS-ON bring-up diagnostics: RNDIS + telnetd + dropbear ~15s into the
# initramfs, kernel log forced visible on the framebuffer console.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
prereqs) prereqs; exit 0 ;;
esac

LOCAL_IP=192.168.2.15
ANDROID_USB=/sys/class/android_usb/android0
GADGET_DIR=/config/usb_gadget

write() { echo -n "$2" >"$1" 2>/dev/null; }

(
    # restore full kernel printk to the console (LK may append quiet/loglevel)
    echo 7 > /proc/sys/kernel/printk 2>/dev/null
    dmesg -n 7 2>/dev/null
    echo "==== cph2579 initrd debug overlay alive ====" > /dev/console 2>&1

    mkdir -p /dev/pts /run
    grep -q devpts /proc/mounts 2>/dev/null || \
        mount -t devpts -o noexec,nosuid,gid=5,mode=0620 devpts /dev/pts 2>/dev/null
    ls -l /dev/ptmx > /dev/console 2>&1
    ls /dev/pts > /dev/console 2>&1

    mkdir -p /config
    mount -t configfs none /config 2>/dev/null

    if [ -d $ANDROID_USB ]; then
        write $ANDROID_USB/enable 0
        write $ANDROID_USB/functions ""
        write $ANDROID_USB/idVendor 18D1
        write $ANDROID_USB/idProduct D001
        write $ANDROID_USB/iManufacturer "Halium initrd"
        write $ANDROID_USB/iProduct "initrd ssh 192.168.2.15"
        write $ANDROID_USB/iSerial "cph2579 bring-up"
        write $ANDROID_USB/functions rndis
        write $ANDROID_USB/enable 1
    elif [ -d $GADGET_DIR ]; then
        mkdir $GADGET_DIR/g1 2>/dev/null
        write $GADGET_DIR/g1/idVendor "0x18D1"
        write $GADGET_DIR/g1/idProduct "0xD001"
        mkdir -p $GADGET_DIR/g1/strings/0x409
        write $GADGET_DIR/g1/strings/0x409/serialnumber "cph2579 bring-up"
        write $GADGET_DIR/g1/strings/0x409/manufacturer "Halium initrd"
        write $GADGET_DIR/g1/strings/0x409/product "initrd ssh 192.168.2.15"
        mkdir -p $GADGET_DIR/g1/functions/rndis.usb0 2>/dev/null
        mkdir -p $GADGET_DIR/g1/configs/c.1/strings/0x409 2>/dev/null
        write $GADGET_DIR/g1/configs/c.1/strings/0x409/configuration "rndis"
        ln -sf $GADGET_DIR/g1/functions/rndis.usb0 $GADGET_DIR/g1/configs/c.1
        UDC=$(ls /sys/class/udc 2>/dev/null | grep -v dummy | head -1)
        write $GADGET_DIR/g1/UDC "$UDC"
    fi

    IFACE=notfound
    /sbin/ifconfig rndis0 $LOCAL_IP 2>/dev/null && IFACE=rndis0
    [ x$IFACE = xnotfound ] && /sbin/ifconfig usb0 $LOCAL_IP 2>/dev/null && IFACE=usb0

    if [ x$IFACE = xnotfound ]; then
        echo "init-top/00-telnetd: USB setup FAILED" > /dev/console 2>&1
        exit 0
    fi
    echo "init-top/00-telnetd: shell services on $IFACE $LOCAL_IP (telnet:23/25 ssh:22)" > /dev/console 2>&1

    # DHCP server so the PC automatically gets an address on the RNDIS link
    echo "start 192.168.2.20" >/etc/udhcpd.conf
    echo "end 192.168.2.90" >>/etc/udhcpd.conf
    echo "lease_file /var/udhcpd.leases" >>/etc/udhcpd.conf
    echo "interface $IFACE" >>/etc/udhcpd.conf
    echo "option subnet 255.255.255.0" >>/etc/udhcpd.conf
    busybox udhcpd 2>/dev/null

    busybox telnetd -b 0.0.0.0:23 -l /bin/sh 2>/dev/null
    busybox telnetd -b 0.0.0.0:25 -l /bin/sh 2>/dev/null

    sed -i 's|:x:|::|' /etc/passwd 2>/dev/null
    mkdir -p /etc/dropbear
    dropbear -R -B -E -p 22 2>/dev/null || dropbear -R -B -E 2>/dev/null

    # continuously mirror the kernel log to the framebuffer console
    while :; do
        dmesg | tail -35 > /dev/console 2>&1
        sleep 15
    done
) &
