#!/bin/sh
# The halium script redirects all output to /dev/kmsg (exec &>/dev/kmsg),
# hiding panic reasons from the framebuffer console. Continuously repaint the
# last kmsg lines on screen so the panic reason becomes visible/photographable.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case $1 in
prereqs) prereqs; exit 0 ;;
esac

mkdir -p /dev/pts
grep -q devpts /proc/mounts 2>/dev/null || \
    mount -t devpts -o noexec,nosuid,gid=5,mode=0620 devpts /dev/pts 2>/dev/null

(
    sleep 3
    echo "==== initrd panic debug (kmsg tail, refresh 10s) ====" > /dev/console 2>&1
    while :; do
        dmesg | tail -45 > /dev/console 2>&1
        sleep 10
    done
) &
